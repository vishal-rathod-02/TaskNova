SECRET_KEY=change-this
JWT_SECRET_KEY=change-this-too
DATABASE_URL=sqlite:///DatabaseName.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL_DAYS=7
DASHBOARD_CACHE_TTL=60
ADMIN_DASHBOARD_CACHE_TTL=120
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@tasknova.com
ADMIN_PASSWORD=change-to-your-strong-password

# Email / SMTP Notification Settings (Supports Gmail App Password - No Domain Required)
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_DEFAULT_SENDER=TaskNova <your_email@gmail.com>
APP_FRONTEND_URL=https://task-nova-app.vercel.app

