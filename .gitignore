# ==========================================
# TaskNova Production .gitignore
# ==========================================

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Backend Runtime
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
backend/instance/
backend/migrations/
backend/tasknova.db
backend/uploads/
backend/celerybeat-schedule
backend/celerybeat-schedule*

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
.turbo
.vite/
